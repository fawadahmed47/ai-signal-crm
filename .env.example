# Web application
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://signal_crm:signal_crm@localhost:5432/signal_crm

# Local PostgreSQL container (development only)
POSTGRES_DB=signal_crm
POSTGRES_USER=signal_crm
POSTGRES_PASSWORD=signal_crm
POSTGRES_PORT=5432

# Ingestion service
NER_MODEL=qwen2.5:1.5b
OLLAMA_HOST=http://localhost:11434
SIGNAL_SOURCE_RSS=https://www.datacenterdynamics.com/en/rss/

# Optional integrations
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=
